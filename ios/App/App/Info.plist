<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Magic Scroll</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Magic Scroll uses the microphone for the instrument tuner.</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>

  <!-- The app only uses standard HTTPS/TLS (exempt) — no custom crypto
       anywhere in MagicScroll-release.html or the Capacitor shell itself.
       (The one SHA-256 hash in the project, in
       supabase/functions/_shared/publishSong.ts, is a one-way content hash
       for dedup, runs server-side in a Supabase Edge Function, and isn't
       part of this app binary at all — irrelevant to this key either way.)
       Setting this to false skips the manual export-compliance prompt on
       every future App Store Connect submission. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- ── NEW: registers Magic Scroll as an "Open in…"/AirDrop/Mail-attachment
       target for the app's supported file types. See CFBundleTypeRole notes
       below each entry for why some are Editor vs Viewer. .txt/.html/.mid/
       .json/.xml reuse Apple's own system UTIs; .mslead/.mscz/.abc/.mxl/
       .musicxml have no system UTI, so this app declares and owns one for
       each (see UTExportedTypeDeclarations below). ─────────────────────── -->
  <!-- Required alongside CFBundleDocumentTypes (Apple rejects the build
       without one of UISupportsDocumentBrowser or this — ITMS-90737). NO,
       not the "recommended" YES: AppDelegate.swift's bridge reads the file
       once via Data(contentsOf:) then deletes it — the "copy into the app's
       Inbox, done" model this key's NO describes — rather than true
       in-place editing (which needs startAccessingSecurityScopedResource()
       around the read, not present here; setting YES without that risks
       permission failures on files opened from iCloud Drive/other
       providers). -->
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <false/>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Chord Sheet</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.plain-text</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Chord Sheet (HTML)</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.html</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MIDI File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.midi-audio</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Song Data (JSON)</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.json</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MusicXML</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.xml</string>
        <string>com.magicscroll.app.musicxml</string>
      </array>
    </dict>
    <!-- Magic Scroll's own format — readable AND writable (Save As), so Editor -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Magic Scroll Lead Sheet</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.magicscroll.app.mslead</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>MuseScore File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.magicscroll.app.mscz</string>
      </array>
    </dict>
    <!-- Magic Scroll can import AND export .abc (Save As), so Editor -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>ABC Notation</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.magicscroll.app.abc</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Compressed MusicXML</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.magicscroll.app.mxl</string>
      </array>
    </dict>
  </array>

  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.magicscroll.app.mslead</string>
      <key>UTTypeDescription</key>
      <string>Magic Scroll Lead Sheet</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mslead</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.magicscroll.app.mscz</string>
      <key>UTTypeDescription</key>
      <string>MuseScore File</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mscz</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.magicscroll.app.abc</string>
      <key>UTTypeDescription</key>
      <string>ABC Notation</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>abc</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.magicscroll.app.mxl</string>
      <key>UTTypeDescription</key>
      <string>Compressed MusicXML</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mxl</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.magicscroll.app.musicxml</string>
      <key>UTTypeDescription</key>
      <string>MusicXML</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.xml</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>musicxml</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
